rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function conectado() {
      return request.auth != null;
    }

    function meuPerfil() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }

    function souDono() {
      return conectado() && meuPerfil().role == "owner";
    }

    function souMotoboy() {
      return conectado() && meuPerfil().role == "courier";
    }

    match /profiles/{uid} {
      allow create: if conectado()
        && request.auth.uid == uid
        && request.resource.data.role == "customer"
        && request.resource.data.keys().hasOnly([
          "name", "email", "whatsapp", "instagram",
          "address", "role", "createdAt"
        ]);

      allow read: if conectado()
        && (request.auth.uid == uid || souDono());

      allow update: if souDono()
        || (
          conectado()
          && request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["name", "whatsapp", "instagram", "address"])
        );

      allow delete: if souDono();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if souDono();
    }

    match /orders/{orderId} {
      allow create: if conectado()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.courierId == null
        && request.resource.data.keys().hasOnly([
          "customerId", "customerName", "phone", "address",
          "instagram", "items", "subtotal", "deliveryFee",
          "total", "paymentMethod", "status", "courierId",
          "createdAt", "updatedAt"
        ])
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number
        && request.resource.data.total > 0;

      allow read: if conectado() && (
        resource.data.customerId == request.auth.uid
        || souDono()
        || (
          souMotoboy()
          && resource.data.courierId == request.auth.uid
        )
      );

      allow update: if souDono()
        || (
          souMotoboy()
          && resource.data.courierId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "updatedAt"])
          && request.resource.data.status in [
            "out_for_delivery", "delivered"
          ]
        );

      allow delete: if souDono();
    }
  }
}
