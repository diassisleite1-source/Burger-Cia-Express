rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function souDono() {
      return request.auth != null
        && firestore.get(
          /databases/(default)/documents/profiles/$(request.auth.uid)
        ).data.role == "owner";
    }

    match /products/{productId}/{fileName} {
      allow read: if true;

      allow write: if souDono()
        && request.resource != null
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches(
          "image/(jpeg|png|gif)"
        );
    }
  }
}
